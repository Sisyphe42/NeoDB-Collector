{
  "$defs": {
    "ApiError": {
      "properties": {
        "code": {
          "type": "string"
        },
        "field": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "format": "uint32",
      "maximum": 4294967295,
      "minimum": 1,
      "type": "integer"
    },
    "error": {
      "$ref": "#/$defs/ApiError"
    },
    "jobId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "type": "string"
    }
  },
  "required": [
    "jobId",
    "attempt",
    "error"
  ],
  "title": "PreviewAdmissionFailure",
  "type": "object"
}
