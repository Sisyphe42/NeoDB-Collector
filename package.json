{
  "name": "neodb-collector-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "contracts:generate": "node tools/contracts.mjs",
    "contracts:check": "node tools/contracts.mjs --check",
    "boundaries:check": "node tools/boundaries.mjs",
    "lint": "eslint apps packages tools tests --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm --filter @neodb-collector/webui build",
    "smoke": "node tests/smoke.mjs",
    "verify": "node tools/verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "ajv": "8.20.0",
    "eslint": "10.10.0",
    "globals": "17.4.0",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
